# Telegram credentials used by the contact form API route.
# Never commit real values.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Public origin used for canonical URLs, Open Graph metadata, robots.txt,
# and sitemap.xml. Set this to the final HTTPS origin in production.
SITE_URL=http://localhost:3000
